FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// All vertices given in millimetres; scaled to metres below.
scale   0.001;

// Domain: 32 mm (x) x 24 mm (y, vertical) x 32 mm (z), 1 mm cells.
vertices
(
    (  0  0  0 )   // 0
    ( 32  0  0 )   // 1
    ( 32 24  0 )   // 2
    (  0 24  0 )   // 3
    (  0  0 32 )   // 4
    ( 32  0 32 )   // 5
    ( 32 24 32 )   // 6
    (  0 24 32 )   // 7
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (32 24 32) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    outlet                  // top face (carved into nozzle + outlet later)
    {
        type patch;
        faces ( (3 2 6 7) );
    }
    bottom                  // y = 0 (chip backside + fluid floor after split)
    {
        type wall;
        faces ( (0 1 5 4) );
    }
    walls                   // four vertical side walls
    {
        type wall;
        faces
        (
            (0 3 7 4)       // x = 0
            (1 2 6 5)       // x = 32 mm
            (0 1 2 3)       // z = 0
            (4 5 6 7)       // z = 32 mm
        );
    }
);

mergePatchPairs
(
);

