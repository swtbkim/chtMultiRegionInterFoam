FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Carve the central jet "nozzle" inlet out of the top "outlet" patch.
pointSync   false;

patches
(
    {
        name            nozzle;
        patchInfo       { type patch; }
        constructFrom   set;
        set             nozzleFaces;
    }
);

